{
  "name": "not-a-wrapper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "scripts": {
    "dev": "concurrently --names \"next,convex\" -c \"cyan,magenta\" \"next dev\" \"convex dev\"",
    "dev:clean": "rm -rf .next && bun run dev",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "bun run convex:deploy",
    "build:next": "next build",
    "convex:schema-preflight": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --prod --require-diff-base",
    "convex:schema-preflight:dry-run": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --require-diff-base --dry-run",
    "convex:deploy": "node scripts/convex-deploy.mjs",
    "env:check": "node scripts/validate-env.mjs .env.local",
    "start": "next start",
    "lint": "eslint .",
    "agent:login": "bun scripts/agent-login.ts",
    "qa:capture": "bun scripts/qa-capture.ts",
    "smoke:openrouter": "bun scripts/smoke-openrouter.ts",
    "catalog:openrouter": "bun scripts/generate-openrouter-catalog.ts",
    "catalog:openrouter:refresh": "bun scripts/generate-openrouter-catalog.ts --fetch",
    "catalog:openrouter:check": "bun scripts/generate-openrouter-catalog.ts --check",
    "catalog:models:audit": "bun scripts/audit-model-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:chat": "vitest bench --run benchmarks/chat-performance",
    "bench:browser": "bun run benchmarks/chat-performance/browser/harness.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/mcp": "2.0.34",
    "@ai-sdk/mistral": "^4.0.31",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/perplexity": "^4.0.30",
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/provider-utils": "^5.0.28",
    "@ai-sdk/react": "^4.0.76",
    "@ai-sdk/xai": "^4.0.42",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/workos-authkit": "^0.2.9",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.63.0",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@types/mdast": "^4.0.4",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.7.0",
    "ai": "^7.0.73",
    "braintrust": "^3.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.44.0",
    "convex-helpers": "0.1.123",
    "embla-carousel-react": "^8.6.0",
    "exa-js": "^2.16.0",
    "file-type": "^22.0.1",
    "idb-keyval": "^6.2.6",
    "input-otp": "^1.4.2",
    "jsdom": "^29.1.1",
    "motion": "^12.42.2",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "prosemirror-commands": "^1.7.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.9",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.9.2",
    "redis": "^6.2.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remend": "^1.3.0",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "vaul-base": "^1.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
